NODE_ENV=production

# PostgreSQL (used by docker-compose postgres service)
POSTGRES_USER=omnicore
POSTGRES_PASSWORD=change_me
POSTGRES_DB=omnicore

# Used by individual services if connecting to an external DB instead
DATABASE_URL=postgresql://omnicore:change_me@db:5432/omnicore

# Auth service
AUTH_PORT=3003
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
JWT_EXPIRATION=1h
REFRESH_EXPIRES_IN=30d

# User service
USER_PORT=3002

# Product service
PRODUCT_PORT=3001
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Gateway
GATEWAY_PORT=3000
