# Root .env for docker-compose only.
# Each service reads its own .env for app config (JWT_SECRET, Cloudinary, etc.).
# Only the vars below are needed here — they configure the shared postgres container
# and override service-level DATABASE_URLs to point to the docker db service.

# PostgreSQL container credentials (must match your services' local .env DB credentials)
POSTGRES_USER=omnicore
POSTGRES_PASSWORD=change_me
POSTGRES_DB=omnicore

# JWT secret — must be identical across omnicore-auth, omnicore-gateway,
# omnicore-product and omnicore-order (used for dual-validation in internal auth)
JWT_SECRET=change_me_use_openssl_rand_hex_32

# Shared internal service token — used to authenticate service-to-service calls.
# Generate a strong random value: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change_me_use_openssl_rand_hex_32

# Optional: override gateway host port (internal services are no longer exposed to host)
# Note: gateway is mapped to 3010 because port 3000 is often occupied locally
GATEWAY_PORT=3010
