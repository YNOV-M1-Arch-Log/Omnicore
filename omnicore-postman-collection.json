    {
      "name": "🗺️ Country Products",
      "description": "Proxied vers omnicore-product (/api/country-products). Requiert countryScope middleware (header X-Country ou query countryId).",
      "item": [
        {
          "name": "POST /api/country-products",
          "event": [
            {
              "listen": "test",
              "script": {
